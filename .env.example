# URL pública del backend, incluyendo /api/v1.
EXPO_PUBLIC_API_URL=

# El botón y las rutas del laboratorio solo aparecen con este valor exacto.
EXPO_PUBLIC_DEVELOPMENT_SECTION=

# Google OAuth. Estos IDs son públicos; nunca agregues client_secret al frontend.
# Crea un cliente por plataforma en Google Cloud para builds nativos.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
