{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ritmo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edenlabs.ritmo"
    },
    "android": {
      "package": "com.edenlabs.ritmo",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Ritmo usa el micrófono para detectar la afinación de tu voz o instrumento y darte feedback en tiempo real."
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
